{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Workbench API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.api-venv/bin/python",
      "cwd": "${workspaceFolder}",
      "args": [
        "api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
